# Template for chart-web-2.env - copy and fill secrets; Vite dev URL: http://127.0.0.1:5714/
# CHART_WEB_PORT below is for reference; PM2 forces the listen port to 5714 for this app.
CHART_WEB_PORT=5714
# Solana desk wallet public address (base58), same keypair as VITE_DESK_PRIVATE_KEY - paste for your records.
DESK_WALLET_ADDRESS=
VITE_DESK_PRIVATE_KEY=
